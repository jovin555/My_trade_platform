ALPACA_API_KEY=your_paper_api_key
ALPACA_SECRET_KEY=your_paper_secret_key
ALPACA_PAPER=true

# Default watchlist and risk settings
# Note: small accounts should use a low-priced ticker and a higher MAX_POSITION_PCT
# so a single share is actually affordable (see project memory for sizing math).
TICKERS=AAPL,MSFT,NVDA,TSLA,AMZN
RUN_INTERVAL_SECONDS=300
MAX_POSITION_PCT=0.1

# IBKR — connects to a locally running IB Gateway/TWS, no static API key.
# 4002 = Gateway paper, 4001 = Gateway live, 7497 = TWS paper, 7496 = TWS live.
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=1

# Software kill switch for live order placement. Must be explicitly "true" for
# src.main_live to send real orders — separate from IBKR's own Read-Only API setting.
TRADING_ENABLED=false

# SMA crossover strategy + daily circuit breaker
SMA_FAST=10
SMA_SLOW=30
DAILY_LOSS_LIMIT_PCT=0.05

# Profit targets — trading halts for the rest of the period once reached
DAILY_PROFIT_TARGET_PCT=0.02
WEEKLY_PROFIT_TARGET_PCT=0.05
MONTHLY_PROFIT_TARGET_PCT=0.10
